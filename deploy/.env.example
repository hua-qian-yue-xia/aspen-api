# Aspen 开发环境环境变量样例, 复制为 deploy/.env 后按需修改; .env 已加入 .gitignore 不入库
# 生产环境必须全部轮换, 并改用 Docker Secret 或受控密钥挂载注入, 禁止沿用任何开发默认值

# 开发 MySQL root 密码 (开发共享实例, 生产数据库独立规划)
MYSQL_ROOT_PASSWORD=aspen-dev-root

# Nacos 专用库账号密码 (MySQL 首启自动创建 nacos_config 库并仅授权该库)
NACOS_MYSQL_PASSWORD=aspen-dev-nacos-db

# Nacos 管理员账号 nacos 的密码, 首启由种子脚本经 API 初始化; 客户端登录使用同一账号
NACOS_ADMIN_PASSWORD=aspen-dev-admin

# Nacos 服务端 JWT 签名密钥, base64 且原文不少于 32 字节, 集群内必须一致
NACOS_AUTH_TOKEN=YXNwZW4tZGV2LW5hY29zLWF1dGgtdG9rZW4tc2VjcmV0LWtleS0zMmJ5dGVz

# Nacos 节点间通信身份标识, 仅为占位约定, 生产必须更换
NACOS_AUTH_IDENTITY_KEY=aspen-identity
NACOS_AUTH_IDENTITY_VALUE=aspen-dev-identity
